{
	# HTTPS certificates for shop addresses (karim.example.com) are created on the first visit,
	# only after the app confirms that the shop exists.
	on_demand_tls {
		ask http://app:3000/api/tls-check
	}
}

(app) {
	encode gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000"
	}
	log {
		output stdout
		format console
	}
}

# Main address and the mother panel
{$DOMAIN}, {$ADMIN_DOMAIN} {
	import app
}

# Every shop's own address
https:// {
	tls {
		on_demand
	}
	import app
}

http:// {
	redir https://{host}{uri} 308
}
