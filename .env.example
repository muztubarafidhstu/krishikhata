# Copy this file to .env and fill in every value:   cp .env.example .env   then   nano .env
# Never share .env and never commit it to GitHub.

# The address of the website, without https:// — e.g. krishikhata.com.bd or a subdomain like app.example.com
DOMAIN=example.com

# Separate address for the mother panel (super admin). Add a DNS A record for it too.
ADMIN_DOMAIN=admin.example.com

# Super admin (you). Mobile = login ID. Password: 5+ characters with a letter, a number and a symbol.
SUPER_PHONE=01XXXXXXXXX
SUPER_PASSWORD=Change@Me1
SUPER_NAME=Super Admin

# Long random secret. Create one with:   openssl rand -hex 32
# It encrypts stored passwords. Keep a copy somewhere safe and NEVER change it later.
APP_SECRET=

# Secret key the ESP32 SMS gateway sends. Create one with:   openssl rand -hex 16
# Put the same value in esp32/sms_gateway/config.h
GATEWAY_KEY=

# Days of nightly database backups to keep in data/backups
BACKUP_KEEP_DAYS=30
